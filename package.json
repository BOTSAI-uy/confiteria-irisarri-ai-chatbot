{
  "name": "confiteria-irisarri-ai-chatbot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "prod": "node --env-file=.env src/index.js",
    "playground": "node --env-file=.env playground/playground.mjs",
    "playground:prod": "node --env-file=.env.prod playground/playground.mjs",
    "playground:script": "node --env-file=.env playground/script.mjs",
    "dev": "node --watch-path=src --env-file=.env src/index.js",
    "start": "node src/index.js",
    "format": "prettier --write \"src/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.mjs\" --fix",
    "prepare": "husky"
  },
  "imports": {
    "#provider/*": "./src/provider/*",
    "#config/*": "./src/config/*",
    "#enums/*": "./src/enums/*",
    "#channels/*": "./src/channels/*",
    "#apps/*": "./src/apps/*",
    "#ai/*": "./src/ai/*",
    "#db/*": "./src/db/*",
    "#storage/*": "./src/storage/*",
    "#utilities/*": "./src/utilities/*",
    "#tools/*": "./src/tools/*",
    "#logger/*": "./src/logger/*",
    "#res/*": "./res/*",
    "#pages/*": "./src/pages/*",
    "#server/*": "./src/server/*",
    "#services/*": "./src/services/*",
    "#scripts/*": "./scripts/*",
    "#initData/*": "./src/initData/*"
  },
  "standard": {
    "rules": {
      "space-before-function-paren": "off",
      "spaced-comment": "off"
    }
  },
  "keywords": [],
  "author": "Johan S",
  "license": "ISC",
  "devDependencies": {
    "depcheck": "1.4.7",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "^7.3.0",
    "neostandard": "^0.13.0",
    "prettier": "3.8.1",
    "unimported": "1.31.1",
    "husky": "9.1.7"
  },
  "dependencies": {
    "appsheet-api": "0.4.4",
    "axios": "1.13.2",
    "baileys": "7.0.0-rc12",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.5",
    "jsonwebtoken": "9.0.2",
    "link-preview-js": "4.0.0",
    "mime-types": "3.0.2",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.10",
    "openai": "6.9.1",
    "papaparse": "5.5.3",
    "pdf-parse-fork": "1.2.0",
    "pino": "10.1.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0"
  }
}
